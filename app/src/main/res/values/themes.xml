<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.DouyinTV" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="Theme.DouyinTV" parent="Base.Theme.DouyinTV">
        <!-- 电视优化 -->
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
    <!-- 只覆盖原生操作菜单，不改变网页或系统输入法主题。 -->
    <style name="ThemeOverlay.DouyinTV.Menu" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="android:colorBackground">#161823</item>
        <item name="android:textColorPrimary">#F3F5FA</item>
        <item name="android:textColorSecondary">#BBC1CE</item>
        <item name="colorAccent">#FE2C55</item>
        <item name="android:windowBackground">@drawable/tv_menu_background</item>
        <item name="android:windowMinWidthMajor">44%</item>
        <item name="android:windowMinWidthMinor">70%</item>
    </style>
</resources>
