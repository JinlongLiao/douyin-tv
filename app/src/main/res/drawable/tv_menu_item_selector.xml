<?xml version="1.0" encoding="utf-8"?>
<!-- 方向键选择使用清晰亮底，普通状态保持面板背景。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape><solid android:color="#D91F49" /><corners android:radius="12dp" /></shape></item>
    <item android:state_selected="true"><shape><solid android:color="#FE2C55" /><corners android:radius="12dp" /></shape></item>
    <item android:state_focused="true"><shape><solid android:color="#FE2C55" /><corners android:radius="12dp" /></shape></item>
    <item android:drawable="@android:color/transparent" />
</selector>
