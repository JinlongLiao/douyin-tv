{
  "manifest_version": 2,
  "name": "抖音电视遥控器",
  "version": "1.0.20.0",
  "description": "为应用内置浏览器提供电视播放控制、返回处理和状态同步。",
  "browser_specific_settings": { "gecko": { "id": "tv-remote@douyin-tv.local" } },
  "permissions": ["nativeMessaging", "nativeMessagingFromContent", "geckoViewAddons"],
  "content_scripts": [{
    "matches": ["https://www.douyin.com/*", "https://douyin.com/*"],
    "run_at": "document_start",
    "all_frames": false,
    "js": ["card-rendering.js"]
  }, {
    "matches": ["https://www.douyin.com/*", "https://douyin.com/*"],
    "run_at": "document_idle",
    "all_frames": false,
    "js": ["native-bridge.js", "playback-scope.js", "remote-controls.js", "playback-context.js"],
    "css": ["tv.css"]
  }]
}
